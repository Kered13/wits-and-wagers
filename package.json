{
  "name": "wits-and-wagers",
  "version": "1.0.0",
  "description": "Wits & Wagers multiplayer web game.",
  "main": "app.ts",
  "type": "module",
  "scripts": {
    "build": "npx tsc --project server/tsconfig.json",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "npx tsx server/app.ts",
    "watch": "npm run watch-server",
    "watch-server": "npx tsx watch server/app.ts",
    "watch-client": "cd client && ng serve"
  },
  "dependencies": {
    "@angular/animations": "^19.0.0",
