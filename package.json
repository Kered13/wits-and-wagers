{
  "name": "wits-and-wagers",
  "version": "1.0.0",
  "description": "Wits & Wagers multiplayer web game.",
  "main": "app.ts",
  "type": "module",
  "scripts": {
    "build": "npm run build-client && npm run build-server",
    "build-server": "tsc --project server/tsconfig.json",
    "build-client": "cd client && ng build",
    "start": "node dist/server/app.js",
    "start-server": "tsx server/app.ts",
    "watch-server": "tsx watch server/app.ts",
    "watch-client": "cd client && ng serve",
    "test-client": "echo \"Error: no test specified\" && exit 1",
    "test-server": "vitest run --config server/vitest.config.ts",
    "test-server-watch": "vitest watch --config server/vitest.config.ts",
    "analyze-bundle": "cd client && ng build --configuration=analyze-bundle && source-map-explorer ../dist/client/browser/**/*.js --no-border-checks"
  },
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/material": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@types/csv-parse": "^1.1.12",
    "@types/multimap": "^1.1.4",
    "complete-common": "^1.1.2",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "express": "^4.21.2",
    "express-ws": "^5.0.2",
    "multimap": "^1.1.0",
    "ng2-fittext": "^2.0.0",
    "ngx-mutation-observer": "^2.2.0",
    "ngx-typed-router": "^1.2.0",
    "random": "^5.4.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.0.5",
    "valibot": "^1.0.0-beta.11",
    "ws": "^8.18.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-ws": "^3.0.5",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "source-map-explorer": "^2.5.3",
    "tsx": "^4.19.2",
    "typescript": "~5.8.0",
    "vitest": "^3.0.5"
  },
  "author": "Derek Brown",
  "license": "MIT"
}
