{
  "name": "wits-and-wagers",
  "version": "1.0.0",
  "description": "Wits & Wagers multiplayer web game.",
  "main": "app.ts",
  "type": "module",
  "scripts": {
    "build": "tsc --project server/tsconfig.json",
    "build-test": "tsc --project server/tsconfig-test.json",
    "start": "tsx server/app.ts",
    "watch": "npm run watch-server",
    "watch-server": "tsx watch server/app.ts",
    "watch-client": "cd client && ng serve",
    "test-client": "cd client && ng test",
    "test-server": "npm run build-test && jasmine --config=server/spec/support/jasmine.mjs"
  },
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/material": "^19.0.4",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@types/multimap": "^1.1.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-ws": "^5.0.2",
    "multimap": "^1.1.0",
    "ngx-typed-router": "^1.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.0.5",
    "valibot": "^1.0.0-beta.11",
    "ws": "^8.18.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.6",
    "@angular/cli": "^19.0.6",
    "@angular/compiler-cli": "^19.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-ws": "^3.0.5",
    "@types/jasmine": "~5.1.0",
    "jasmine": "^5.5.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.0"
  },
  "author": "Derek Brown",
  "license": "MIT"
}
